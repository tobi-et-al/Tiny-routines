# Full OpenAI-compatible chat completions endpoint.
AI_API_URL=https://provider.example/v1/chat/completions
AI_API_KEY=replace-with-a-server-side-secret
AI_MODEL=replace-with-an-open-weight-model-id

# Optional live search. One basic Tavily search is used per generated summary.
TAVILY_API_KEY=replace-with-a-server-side-secret

# Comma-separated additions to the built-in production and local origin allowlist.
ALLOWED_ORIGINS=
